{
  "name": "kitchen-rush-3d",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @kitchen/server\" \"npm run dev -w @kitchen/client\"",
    "build": "npm run typecheck && npm run build -w @kitchen/client && npm run build -w @kitchen/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "accounts:verify-email": "tsx scripts/verify-account-email.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "vitest run tests/postgres-account.integration.test.ts apps/server/tests/account-match.integration.test.ts"
  },
  "overrides": {
    "nanoid": "^3.3.19",
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.13",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
