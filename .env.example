PORT=2567
# Guest remains the default; explicit flags are required to connect the account DB.
GUEST_ONLY=true
DATABASE_URL=postgres://kitchen:kitchen_local@localhost:5432/kitchen
DB_POOL_MAX=10
# Set GUEST_ONLY=false and configure DATABASE_URL before enabling any service.
AUTH_ENABLED=false
REGISTRATION_ENABLED=false
CLOUD_SAVE_ENABLED=false
# Comma-separated exact origins for intentionally separate web/API hosts.
ACCOUNT_ALLOWED_ORIGINS=
VITE_SERVER_URL=http://localhost:2567
